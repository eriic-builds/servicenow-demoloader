@echo off
setlocal DisableDelayedExpansion
set "SN_DEMOSEEDER_RELEASE=%~dp0"
set "SN_DEMOSEEDER_ACTION=%~1"
where pwsh.exe >nul 2>nul
if errorlevel 1 (
  echo FIRST: open PREREQUISITES.html in this extracted folder for the click-by-click setup guide.
  echo PowerShell 7.2 or newer is required. Install it from https://aka.ms/powershell-release and reopen this installer.
  if not "%SN_DEMOSEEDER_NO_PAUSE%"=="1" pause
  exit /b 1
)
pwsh.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';try{if($PSVersionTable.PSVersion -lt [version]'7.2'){throw 'PowerShell 7.2 or newer is required. Open PREREQUISITES.html first.'};$action=$env:SN_DEMOSEEDER_ACTION;if(-not $action){$action='Install'};if($action -notin @('Install','Diagnose','Recover','Verify','Uninstall','Prerequisites')){throw 'Use Install.cmd with Install, Prerequisites, Diagnose, Recover, Verify or Uninstall.'};$root=[IO.Path]::GetFullPath($env:SN_DEMOSEEDER_RELEASE);$file=Join-Path $root 'Install-SN-DemoLoader.ps1';$actual=(Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash;if($actual -ine '@@INSTALLER_SHA256@@'){throw 'Installer integrity mismatch. Obtain the release again from its trusted source.'};$guide=Join-Path $root 'PREREQUISITES.html';if($action -in @('Install','Prerequisites')){if(-not [IO.File]::Exists($guide) -or (Get-FileHash -LiteralPath $guide -Algorithm SHA256).Hash -ine '@@PREREQUISITES_SHA256@@'){throw 'Prerequisites guide integrity mismatch. Extract the complete trusted release again.'}};if($action -eq 'Prerequisites'){Start-Process ([Uri]$guide).AbsoluteUri;Write-Host 'Opened the offline guide. No installation or source action ran.';exit 0};Write-Host ('SN DemoLoader local action: '+$action);$prepared=$false;if($action -eq 'Install'){Write-Host '';Write-Host 'BEFORE INSTALLING - complete these in your own non-production ServiceNow PDI:';Write-Host '1. Wake your PDI and sign in as its Human administrator.';Write-Host '2. Create demo.seeder - Active ON, Identity type Machine, Web service access only ON.';Write-Host '3. Set its own strong private password. Locked out OFF; Password needs reset OFF.';Write-Host '4. Save these roles: admin, itil_admin, knowledge_admin, user_admin.';Write-Host 'These are powerful sandbox permissions, not a production or least-privilege model.';Write-Host 'You also need Windows, Scout, PowerShell 7.2+, Node.js 22+ and Edge.';Write-Host 'The installer does NOT create this account, grant roles, contact ServiceNow or verify access.';Write-Host ('Click-by-click guide: '+$guide);do{$ready=Read-Host 'Type GUIDE for the steps, READY when prepared, or press Enter to cancel';if($ready -ceq 'GUIDE'){Start-Process ([Uri]$guide).AbsoluteUri}}while($ready -ceq 'GUIDE');if($ready -cne 'READY'){Write-Host 'Cancelled. Finish PREREQUISITES.html, then reopen Install.cmd. No files were unblocked or installed.';exit 2};$prepared=$true;Write-Host 'READY is your acknowledgement only. Scout checks the actual account/access later.'};Write-Host '';Write-Host 'Only continue if you got this unsigned release from a publisher you trust.';Write-Host 'Approval unblocks this verified installer. Install also unblocks only its hash-verified PowerShell payload; other files stay untouched. Existing output and credentials are preserved.';Write-Host 'This does not change execution policy, grant permissions, send data or modify ServiceNow.';$answer=Read-Host 'Type TRUST to approve this local action, or press Enter to cancel';if($answer -cne 'TRUST'){Write-Host 'Cancelled. No files were unblocked or installed.';exit 2};Unblock-File -LiteralPath $file;& $file -Action $action -Confirm -TrustDownloadedPayload -PrerequisitesConfirmed:$prepared}catch{Write-Error $_;exit 1}"
set "SN_DEMOSEEDER_RESULT=%errorlevel%"
if not "%SN_DEMOSEEDER_NO_PAUSE%"=="1" pause
exit /b %SN_DEMOSEEDER_RESULT%
